PORT=5001
API_FOOTBALL_KEY=
# Free API-Football plan only allows seasons 2022-2024
SEASON=2024
MONGODB_URI=
# Long random string used to sign login tokens. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Circuit breaker: if API-Football reports a problem with the account (suspended, out of requests, bad key),
# stop calling it for this many minutes and serve saved data instead. Empty = defaults (15 and 60).
API_BREAKER_MINUTES=
# Same, but for "access" errors such as a suspended account.
API_BREAKER_ACCESS_MINUTES=
# Proxies between the internet and Express. Production chain: browser -> Vercel -> Render -> Express = 2.
# Leave empty for the defaults (2 in production, 0 locally). Verify with DEBUG_IP_ENDPOINT after deploying.
TRUST_PROXY_HOPS=
# Set to true briefly after deploying to enable GET /api/_ip, then set it back to false.
DEBUG_IP_ENDPOINT=false
# "Sign in with Google": the OAuth Client ID from Google Cloud Console (a "Web application" client).
# Leave empty to switch Google sign-in off. Use the SAME value as VITE_GOOGLE_CLIENT_ID in the client.
GOOGLE_CLIENT_ID=
